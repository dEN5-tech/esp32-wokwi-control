<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- Стартовый шаблон для практической работы -->
<!-- Студент открывает этот файл в Scene Builder и верстает интерфейс самостоятельно по МЕТОДИЧКА.md -->
<VBox alignment="CENTER" prefHeight="360.0" prefWidth="440.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Создайте интерфейс в Scene Builder по инструкции в МЕТОДИЧКА.md" />
</VBox>
