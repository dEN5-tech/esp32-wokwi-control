<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Стартовый макет для управления сервоприводом в Scene Builder -->
<VBox alignment="CENTER" prefHeight="360.0" prefWidth="400.0" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>

    <!-- Заголовок -->
    <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Управление Сервоприводом Arduino" />

    <!-- Настройки сети (Wokwi Serial порт 4002) -->
    <HBox alignment="CENTER" spacing="8.0">
        <Label text="IP:" />
        <TextField fx:id="ipField" prefWidth="100.0" text="127.0.0.1" />
        <Label text="Порт:" />
        <TextField fx:id="portField" prefWidth="60.0" text="4002" />
    </HBox>

    <!-- Ползунок выбора угла (0 - 180) -->
    <VBox alignment="CENTER" spacing="4.0">
        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Угол сервопривода:" />
            <Label fx:id="angleValueLabel" style="-fx-font-weight: bold;" text="90°" />
        </HBox>
        <Slider fx:id="angleSlider" max="180.0" min="0.0" prefWidth="300.0" showTickLabels="true" showTickMarks="true" value="90.0" />
    </VBox>

    <!-- Кнопки пресетов и отправки -->
    <HBox alignment="CENTER" spacing="8.0">
        <Button onAction="#onSet0" prefWidth="55.0" text="0°" />
        <Button onAction="#onSet90" prefWidth="55.0" text="90°" />
        <Button onAction="#onSet180" prefWidth="55.0" text="180°" />
        <Button onAction="#onApplyAngle" prefWidth="100.0" style="-fx-background-color: #1976d2; -fx-text-fill: white;" text="Применить" />
        <Button onAction="#onGetStatus" prefWidth="70.0" text="Статус" />
    </HBox>

    <!-- Метка текущего статуса -->
    <Label fx:id="statusLabel" text="Текущий угол: 90°" />

    <!-- Окно лога -->
    <TextArea fx:id="logArea" editable="false" prefHeight="80.0" promptText="Лог ответов Arduino..." />
</VBox>
