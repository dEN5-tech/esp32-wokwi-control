<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="330.0" prefWidth="380.0" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <!-- Заголовок -->
    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Управление Arduino Uno (Serial)" />

    <!-- Настройки сети (Wokwi Serial мост) -->
    <HBox alignment="CENTER" spacing="8.0">
        <Label text="IP:" />
        <TextField fx:id="ipField" prefWidth="100.0" text="127.0.0.1" />
        <Label text="Порт:" />
        <TextField fx:id="portField" prefWidth="60.0" text="4001" />
    </HBox>

    <!-- Кнопки управления светодиодом -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#onTurnOn" prefWidth="100.0" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;" text="ВКЛ (ON)" />
        <Button onAction="#onTurnOff" prefWidth="100.0" style="-fx-background-color: #c62828; -fx-text-fill: white; -fx-font-weight: bold;" text="ВЫКЛ (OFF)" />
        <Button onAction="#onCheckStatus" prefWidth="100.0" text="Статус" />
    </HBox>

    <!-- Метка статуса -->
    <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Состояние: ВЫКЛ" />

    <!-- Окно лога ответов -->
    <TextArea fx:id="logArea" editable="false" prefHeight="100.0" promptText="Лог ответов платы..." style="-fx-font-family: monospace;" wrapText="true" />
</VBox>
